{
	"name": "dsh-edit-diff",
	"version": "0.6.0",
	"description": "Redraws line-level diffs on DeepSeek Harness file-mutation tool cards (dedup + inline emphasis), covers run_code (PTC) sub-calls and str_replace_editor, adds a per-turn changed-files card, and reveals any of those paths in the OS file manager through the plugin's own host route.",
	"keywords": [
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"diff",
		"edit",
		"reveal"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/senyayume/dsh-edit-diff.git"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml"
	],
	"scripts": {
		"test": "node test/smoke.mjs && node test/host.mjs"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-ui-primitives"
			],
			"platform": "web"
		}
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-0 <0.1.5-rc.1 || >=0.1.5-rc.1 <0.2.0-0",
		"react": ">=18.2.0 <19"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-client-ui-primitives": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"react": "^18.3.1"
	}
}
